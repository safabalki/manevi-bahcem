# Gizli dosyalar (.jwks.json gibi) dışarıdan okunmasın
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# Veri dosyaları önbelleğe takılmasın
<FilesMatch "\.(json)$">
  Header set Cache-Control "no-cache, max-age=0"
</FilesMatch>
DirectoryIndex index.html
# PWA
AddType application/manifest+json .webmanifest
<Files "sw.js">
  Header set Cache-Control "no-cache, max-age=0"
</Files>
